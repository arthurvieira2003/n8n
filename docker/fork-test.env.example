# Variáveis para docker/portainer-fork-test.stack.yml (Portainer > Stacks > Environment)
#
# Pull com "archive/tar: invalid tar header"?
# - O Dockerfile padrão usa n8nio/base (DHI) com camadas zstd → exige Docker Engine >= 23 no host do Portainer.
# - Confira: docker version (no servidor) ou Portainer > Environment > Status.
# - Solução A: atualizar Docker no servidor para >= 23 (recomendado).
# - Solução B: imagem compat (sem DHI): build com docker/images/n8n/Dockerfile.compat → tag *-compat.

# Imagem no Docker Hub
N8N_FORK_IMAGE=copapel/n8n:1.0.3-compat

# Porta no host (5678 = produção; 5679 = teste do fork)
N8N_FORK_HOST_PORT=5679

# Volume EXISTENTE (o mesmo do n8n na 5678) — não será recriado
N8N_DATA_VOLUME=n8n_n8n_data

N8N_LICENSE_UNLOCK_ALL=true
N8N_EDITOR_BASE_URL=http://SEU_SERVIDOR:5679/

# Mesmo Postgres do container na 5678 (copie os valores do container atual)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=SEU_HOST_POSTGRES
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=SEU_USER
DB_POSTGRESDB_PASSWORD=SUA_SENHA
DB_POSTGRESDB_SCHEMA=public

# GENERIC_TIMEZONE=America/Sao_Paulo
# TZ=America/Sao_Paulo
