# Imagem compatível com Docker Engine < 23 (sem n8nio/base / DHI / camadas zstd).
# Use quando o pull falhar com: archive/tar: invalid tar header
# Build: docker build -f docker/images/n8n/Dockerfile.compat -t copapel/n8n:1.0.3-compat .

ARG NODE_VERSION=24.15.0
ARG N8N_VERSION=snapshot

FROM node:${NODE_VERSION}-alpine3.22 AS builder
COPY ./compiled /usr/local/lib/node_modules/n8n
# Windows pnpm deploy uses junctions; COPY leaves broken node_modules on Linux.
RUN cd /usr/local/lib/node_modules/n8n && \
    if [ ! -f node_modules/semver/functions/satisfies.js ]; then \
      rm -rf node_modules && npm install --omit=dev --ignore-scripts; \
    fi && \
    apk add --no-cache python3 make g++ && \
    npm rebuild sqlite3

FROM node:${NODE_VERSION}-alpine3.22

ARG N8N_VERSION
ARG N8N_RELEASE_TYPE=dev
ENV NODE_ENV=production
ENV N8N_RELEASE_TYPE=${N8N_RELEASE_TYPE}
ENV SHELL=/bin/sh

RUN apk add --no-cache \
    tini \
    tzdata \
    ca-certificates \
    git \
    openssh \
    openssl \
    graphicsmagick=1.3.45-r0 \
    libc6-compat \
    && rm -rf /tmp/* /root/.npm

WORKDIR /home/node

COPY --from=builder /usr/local/lib/node_modules/n8n /usr/local/lib/node_modules/n8n
COPY docker/images/n8n/docker-entrypoint.sh /

RUN sed -i 's/\r$//' /usr/local/lib/node_modules/n8n/bin/n8n && \
    ln -s /usr/local/lib/node_modules/n8n/bin/n8n /usr/local/bin/n8n && \
    mkdir -p /home/node/.n8n && \
    chown -R node:node /home/node && \
    rm -rf /root/.npm /tmp/*

EXPOSE 5678/tcp
USER node
ENTRYPOINT ["tini", "--", "/docker-entrypoint.sh"]

LABEL org.opencontainers.image.title="n8n" \
      org.opencontainers.image.description="Workflow Automation Tool (compat, no DHI base)" \
      org.opencontainers.image.source="https://github.com/n8n-io/n8n" \
      org.opencontainers.image.url="https://n8n.io" \
      org.opencontainers.image.version=${N8N_VERSION}
